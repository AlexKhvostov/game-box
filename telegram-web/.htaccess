# Entry points revalidate; versioned modules and stable media can be reused.
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, must-revalidate"
  <FilesMatch "\.(js|css|svg|png|jpe?g|webp|mp3|wav|ogg|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  <Files "config.php">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^i/([0-9]{1,20})/?$ i.php?r=$1 [L,QSA]
</IfModule>
