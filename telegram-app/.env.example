# Public client configuration only. Never put bot tokens/service_role here.
# Local loopback QA uses /qa-api automatically in DEV.
# Native/production build: set the actual same-origin path or HTTPS endpoint.
VITE_TELEGRAM_API_URL=/telegram-api
# Optional public bot/Main Mini App URL for score sharing (no secret/query).
VITE_TELEGRAM_APP_URL=https://t.me/TestUntouch_bot
# A visible QA label, never an auth bypass. Local fixtures require DEV+loopback.
VITE_QA_MODE=false
